{
  "manifest_version": 2,
  "name": "Scriflow page capture",
  "version": "1.0.0",
  "browser_specific_settings": { "gecko": { "id": "browser@scriflow.local", "strict_min_version": "140.0" } },
  "permissions": ["geckoViewAddons", "nativeMessaging", "nativeMessagingFromContent", "webRequest", "webRequestBlocking", "tabs", "<all_urls>"],
  "background": { "scripts": ["background.js"] },
  "options_ui": { "page": "bootstrap.html", "open_in_tab": true },
  "content_scripts": [{ "matches": ["https://*/*", "file:///*"], "js": ["content.js"], "run_at": "document_idle", "all_frames": false }],
  "content_security_policy": "script-src 'self'; object-src 'none'"
}
