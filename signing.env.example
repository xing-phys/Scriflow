# Copy this to an ignored local file, fill it in, then export its values.
# Example: set -a; source .tools/signing.env; set +a
# Never commit the filled file or the keystore. Back up the key securely.
SCRIBBLOW_KEYSTORE="/absolute/path/to/scribblow-release.keystore"
SCRIBBLOW_KEY_ALIAS="scribblow"
SCRIBBLOW_STORE_PASSWORD="replace-with-your-store-password"
SCRIBBLOW_KEY_PASSWORD="replace-with-your-key-password"
