# Copy this to an ignored local file, fill it in, then export its values.
# Example: set -a; source .tools/signing.env; set +a
# Never commit the filled file or the keystore. Back up the key securely.
# Use the existing release key and its actual alias; an app rename does not change them.
SCRIFLOW_KEYSTORE="/absolute/path/to/scriflow-release.keystore"
SCRIFLOW_KEY_ALIAS="your-existing-key-alias"
SCRIFLOW_STORE_PASSWORD="replace-with-your-store-password"
SCRIFLOW_KEY_PASSWORD="replace-with-your-key-password"
