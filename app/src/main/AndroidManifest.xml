<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android" xmlns:tools="http://schemas.android.com/tools">
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.INTERNET" />
    <application android:label="@string/app_name" android:icon="@mipmap/ic_launcher" android:theme="@style/ScriflowTheme" android:allowBackup="false" android:usesCleartextTraffic="false" android:supportsRtl="true">
        <!-- This optional dependency entry is removed, never instantiated. -->
        <receiver android:name="androidx.profileinstaller.ProfileInstallReceiver" tools:node="remove" tools:ignore="MissingClass" />
        <!-- Match Jnotes' firmware-managed scrolling/handwriting policy on this tablet.
             This is an app policy, not a raw EPDC waveform number. -->
        <meta-data android:name="hw_eink.app.refresh.mode" android:value="13" />
        <!-- New screens inherit the direction beneath them until the shared app direction
             is applied before content creation. Existing screens are synchronized in the
             back stack. Normal recreation rebuilds the native writing surface. -->
        <activity android:name=".notebook.NotebookActivity" android:exported="false" android:screenOrientation="behind" />
        <activity android:name=".notebook.NotebookAiActivity" android:exported="false" android:screenOrientation="behind" />
        <activity android:name=".notebook.NotebookBrowserActivity" android:exported="false" android:screenOrientation="behind" />
        <activity android:name=".notebook.NotebookWebsitesActivity" android:exported="false" android:screenOrientation="behind" />
        <!-- File pickers can temporarily force a different orientation. Keep the
             transfer owner and its outstanding result intact across that change. -->
        <activity android:name=".notebook.NotebookMediaActivity" android:exported="false" android:screenOrientation="behind" android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden" />
        <activity android:name=".notebook.NotebookTransferActivity" android:exported="false" android:screenOrientation="behind" android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden" />
        <activity android:name=".notebook.NotebookPdfImportActivity" android:exported="false" android:screenOrientation="behind" android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden" />
        <activity android:name=".notebook.NotebookPdfExportActivity" android:exported="false" android:screenOrientation="behind" android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden" />
        <activity android:name=".notebook.NotebookSettingsActivity" android:exported="false" android:screenOrientation="behind" />
        <activity android:name=".notebook.NotebookLibraryActivity" android:exported="true" android:screenOrientation="behind">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
