<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android" xmlns:tools="http://schemas.android.com/tools">
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="29" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" android:maxSdkVersion="29" />
    <!-- Files is a user-initiated shared-storage file manager. Newer Android
         versions grant this through their dedicated All files access setting. -->
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" tools:ignore="ScopedStorage" />
    <uses-feature android:name="android.hardware.microphone" android:required="false" />
    <application android:label="@string/app_name" android:icon="@mipmap/ic_launcher" android:theme="@style/ScriflowTheme" android:allowBackup="false" android:usesCleartextTraffic="false" android:supportsRtl="true" android:requestLegacyExternalStorage="true">
        <provider android:name=".notebook.NotebookClipboardProvider" android:authorities="${applicationId}.noteclipboard"
            android:exported="false" android:grantUriPermissions="true" />
        <provider android:name=".notebook.NotebookFileProvider" android:authorities="${applicationId}.tabletfiles"
            android:exported="false" android:grantUriPermissions="true" />
        <!-- This optional dependency entry is removed, never instantiated. -->
        <receiver android:name="androidx.profileinstaller.ProfileInstallReceiver" tools:node="remove" tools:ignore="MissingClass" />
        <!-- Match Jnotes' firmware-managed scrolling/handwriting policy on this tablet.
             This is an app policy, not a raw EPDC waveform number. -->
        <meta-data android:name="hw_eink.app.refresh.mode" android:value="13" />
        <!-- New screens inherit the direction beneath them until the shared app direction
             is applied before content creation. Existing screens are synchronized in the
             back stack. Normal recreation rebuilds the native writing surface. -->
        <activity android:name=".notebook.NotebookActivity" android:exported="false" android:screenOrientation="behind" />
        <activity android:name=".notebook.NotebookAiActivity" android:exported="false" android:screenOrientation="behind" />
        <!-- Resize the browser and existing note surfaces without restarting live web documents. -->
        <activity android:name=".notebook.NotebookBrowserActivity" android:exported="false" android:screenOrientation="behind" android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden" />
        <activity android:name=".notebook.NotebookBrowserBookmarksActivity" android:exported="false" android:screenOrientation="behind" />
        <activity android:name=".notebook.NotebookBrowserHistoryActivity" android:exported="false" android:screenOrientation="behind" />
        <activity android:name=".notebook.NotebookBrowserDataActivity" android:exported="false" android:screenOrientation="behind" />
        <activity android:name=".notebook.NotebookWebsitesActivity" android:exported="false" android:screenOrientation="behind" />
        <activity android:name=".notebook.NotebookFilesActivity" android:exported="false" android:screenOrientation="behind" />
        <!-- File pickers can temporarily force a different orientation. Keep the
             transfer owner and its outstanding result intact across that change. -->
        <activity android:name=".notebook.NotebookMediaActivity" android:exported="false" android:screenOrientation="behind" android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden" />
        <activity android:name=".notebook.NotebookTransferActivity" android:exported="false" android:screenOrientation="behind" android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden" />
        <activity android:name=".notebook.NotebookPdfImportActivity" android:exported="true" android:screenOrientation="behind" android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="application/pdf" android:scheme="content" />
                <data android:scheme="file" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="application/pdf" />
            </intent-filter>
        </activity>
        <activity android:name=".notebook.NotebookPdfExportActivity" android:exported="false" android:screenOrientation="behind" android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden" />
        <activity android:name=".notebook.NotebookSettingsActivity" android:exported="false" android:screenOrientation="behind" />
        <activity android:name=".notebook.NotebookLibraryActivity" android:exported="true" android:screenOrientation="behind">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
