<resources>
    <style name="ScriflowTheme" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:windowElevation">0dp</item>
        <item name="android:alertDialogTheme">@style/ScriflowDialog</item>
        <item name="android:dialogTheme">@style/ScriflowDialog</item>
        <item name="android:popupWindowStyle">@style/ScriflowPopup</item>
    </style>
    <style name="ScriflowDialog" parent="android:style/Theme.Material.Light.Dialog.Alert">
        <item name="android:windowElevation">0dp</item>
        <item name="android:windowBackground">@drawable/flat_dialog</item>
        <item name="android:backgroundDimEnabled">false</item>
    </style>
    <style name="ScriflowPopup" parent="android:style/Widget.Material.PopupWindow">
        <item name="android:popupElevation">0dp</item>
        <item name="android:popupBackground">@drawable/flat_dialog</item>
    </style>
</resources>
